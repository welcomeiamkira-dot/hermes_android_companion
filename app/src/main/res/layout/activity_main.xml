<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Voice Input Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/voiceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:contentDescription="Voice Input"
        android:tint="@android:color/white"
        android:backgroundTint="@android:color/holo_green_dark" />

    <!-- Screenshot Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/screenshotButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@id/voiceButton"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_menu_camera"
        android:contentDescription="Screenshot"
        android:tint="@android:color/white"
        android:backgroundTint="@android:color/holo_purple" />

    <!-- Wake Word Toggle -->
    <ToggleButton
        android:id="@+id/wakeWordToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@id/screenshotButton"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:textOn="Wake: ON"
        android:textOff="Wake: OFF"
        android:textSize="10sp"
        android:padding="8dp" />

</RelativeLayout>
